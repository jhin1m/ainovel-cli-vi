# Cài tại /etc/caddy/Caddyfile. Đổi novel.example.com thành tên miền thật.
#
# Cloudflare: SSL/TLS = Full (strict) với Cloudflare Origin Certificate (xem docs/web-server.md).
# Tường lửa chỉ mở 443 cho dải IP Cloudflare, nên mọi kết nối tới Caddy đều đến từ Cloudflare.
# Caddy không tự xin chứng chỉ được ở cấu hình này (challenge ACME không qua được proxy Cloudflare).
#
# Dải IP Cloudflare đổi theo thời gian. Lấy bản mới nhất và cập nhật danh sách dưới đây
# (và luật tường lửa) khi Cloudflare thông báo:
#   curl -fsS https://www.cloudflare.com/ips-v4; echo; curl -fsS https://www.cloudflare.com/ips-v6
{
	servers {
		# Chỉ tin header IP do Cloudflare gửi tới; client_ip (và {client_ip}) lấy từ
		# CF-Connecting-IP khi peer thuộc dải này, nếu không thì là IP kết nối thật.
		trusted_proxies static \
			173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
			141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
			197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
			104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
			2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

novel.example.com {
	# Origin Certificate tạo ở Cloudflare; file thuộc root:caddy, key quyền 0640.
	tls /etc/caddy/cf-origin.pem /etc/caddy/cf-origin.key

	# Nén mọi thứ trừ SSE: nén làm trình duyệt nhận event trễ.
	@compressible {
		not path /api/books/*/events
	}
	encode @compressible zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
		# CSP, X-Content-Type-Options, X-Frame-Options, Referrer-Policy do ứng dụng đặt.
	}

	reverse_proxy 127.0.0.1:8080 {
		# SSE: đẩy ngay từng event, không đệm.
		flush_interval -1
		# Ghi đè (không nối thêm) để client không tự giả mạo X-Forwarded-For.
		# Server đặt AINOVEL_TRUSTED_PROXIES=127.0.0.1/32 và đọc header này.
		header_up X-Forwarded-For {client_ip}
		header_up -CF-Connecting-IP
		transport http {
			# SSE giữ kết nối lâu (backend gửi header ngay) nên chỉ giới hạn thời gian chờ header.
			# Phải lớn hơn exportTimeout của server (80s) và nhỏ hơn giới hạn 100s của Cloudflare,
			# để lượt xuất chậm bị server cắt trước thay vì Caddy trả 502.
			dial_timeout 5s
			response_header_timeout 90s
		}
	}

	log {
		output file /var/log/caddy/ainovel.log
	}
}
